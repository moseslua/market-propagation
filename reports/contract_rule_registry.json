  "equivalence_gate": {
    "all_required_fields_must_match": true,
    "similar_titles_sufficient": false,
    "title_text_is_a_lead_only": true,
    "required_outcome": "two contracts are one claim only when every required field agrees",
    "on_any_mismatch": "record_both_contracts_as_distinct_claims_and_report_the_difference"
  },
  "exact_match_function_contract": {
    "name": "exact_match",
    "signature": "exact_match(left: Contract, right: Contract) -> dict",
    "returns": {
      "matches": "boolean",
      "differences": "list of differing fields with both values recorded"
    },
    "differences_are_always_reported": true,
    "differences_suppressed_when_matches_is_true": false
  },
  "coherence_checklist": {
    "distance_definition": "minimum_maximum_distance_to_the_quoted_box_over_the_simplex",
    "solver": "scipy.optimize.linprog",
    "weights": "simplex",
    "inputs": "synchronized_valid_quotes_only",
    "synchronization_and_validity_enforced_by": "caller",
    "uncertainty_unit": "economic_release",
    "uncertainty_rule": "Coherence uncertainty resamples whole releases and keeps each release's synchronized coherence curve intact. Individual synchronized quote snapshots are dependent observations of one release and are never resampled as independent units, because that is pseudo replication.",
    "supports": [
      "fractional_payouts",
      "strict_and_non_strict_thresholds",
      "rounding"
    ],
    "projected_prices_never_substituted_for_raw_observations": true,
    "infeasibility_meaning": "quote_coherence_finding_under_stated_assumptions_not_an_executable_arbitrage",
    "binary_scoring_rejects_exceptional_payouts": true,
    "half_payout_relabelled_as_binary": false
  },
