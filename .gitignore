# Local orchestration and index state.
.omx/
.omx-state-locks/
.omx-state-locks.identity.json
.codegraph

# Runtime output. `configs/scheduled-reports.cron` writes both of these: it appends job
# transcripts to `logs/` and generated JSON reports to `reports/generated/`. Neither is
# a report source. The committed report sources stay directly under `reports/`.
logs/
reports/generated/

# Captured rule text, and the records attested from it, are acquired data rather than
# repository sources: the capture root holds bytes fetched from a public venue.
rules/

# Captured venue metadata and the per-contract records read from it, for the same
# reason and from a second venue: the pages are fetched bytes rather than repository
# sources, and `configs/matching_v1.yaml` declares the store outside the sources.
polymarket-metadata/

